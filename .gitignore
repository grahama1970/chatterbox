.vscode

# Pylance
pyrightconfig.json

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

syn_out/
checkpoints/
.gradio

# Ignore generated sample .wav files
**/*.wav

# Local runtime output. Keep these paths in the repo so agents do not default
# to host /tmp for receipts, logs, and resumable state.
tmp/*
!tmp/.gitkeep
logs/*
!logs/.gitkeep

# Narrator reference audio and its provenance are LOCAL ONLY. The sources are audiobooks
# whose rights are UNVERIFIED and this repository is PUBLIC, so publishing them would
# distribute third-party audio. WAVs are already covered by **/*.wav; the provenance
# sidecars are ignored too so an accidental `git add voices/` cannot publish the source
# chain either. Backed up outside git at /mnt/storage12tb/embry-voice/references-voices.
voices/
